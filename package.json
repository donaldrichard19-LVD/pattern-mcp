{
  "name": "pattern-mcp",
  "version": "0.17.1",
  "description": "Pattern checks a coding agent's UI decisions against real evidence before it builds, whether that means your own design system in code or Figma, or components from popular libraries. It helps the agent choose what the product actually needs without overbuilding. An opt-in enforcement boundary can make that check required, and every decision is recorded in an auditable ledger you can verify later.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pattern-mcp": "dist/index.js",
    "pattern-check-gate": "dist/check-gate.js",
    "pattern-check-gate-hook": "dist/check-gate-hook.js"
  },
  "author": "Don Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donaldrichard19-LVD/pattern-mcp.git"
  },
  "homepage": "https://github.com/donaldrichard19-LVD/pattern-mcp#readme",
  "bugs": {
    "url": "https://github.com/donaldrichard19-LVD/pattern-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ui-components",
    "shadcn",
    "design-system",
    "claude-code",
    "ai-agent-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@posthog/mcp": "^0.13.0",
    "posthog-node": "^5.51.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
