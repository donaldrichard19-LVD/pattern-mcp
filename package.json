{
  "name": "pattern-mcp",
  "version": "0.8.1",
  "description": "MCP server that turns your design guidance into a checkable process -- evaluates UI components from external libraries (shadcn/ui, 21st.dev, ReUI) or your own registered design system against a requirements checklist, then tells the agent whether to reuse an existing component or build one from a concrete design reference.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pattern-mcp": "dist/index.js"
  },
  "author": "Don Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donaldrichard19-LVD/pattern-mcp.git"
  },
  "homepage": "https://github.com/donaldrichard19-LVD/pattern-mcp#readme",
  "bugs": {
    "url": "https://github.com/donaldrichard19-LVD/pattern-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ui-components",
    "shadcn",
    "design-system",
    "claude-code",
    "ai-agent-tools"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "posthog-node": "^5.51.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
